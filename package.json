{
  "name": "techbuy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:clean": "npm run clean && next dev -p 3000",
    "clean": "rm -rf .next node_modules/.cache",
    "build": "next build",
    "build:clean": "npm run clean && next build",
    "validate:images": "node --experimental-strip-types scripts/validate-product-images.ts",
    "scan:product-images": "node --experimental-strip-types scripts/scan-product-images.ts",
    "validate:hero-images": "node --experimental-strip-types scripts/validate-hero-images.ts",
    "start": "next start -p 3000",
    "start:prod": "next start -p 3002",
    "lint": "next lint"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "motion": "^13.1.0",
    "next": "^15.4.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.11",
    "@types/node": "^22.17.1",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/three": "^0.185.4",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.2"
  }
}
