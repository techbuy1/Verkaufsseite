# TechBuy — Environment Variables
# Kopiere diese Datei nach `.env.local` für die lokale Entwicklung.
# `.env.local` niemals committen.
#
# Production (www.techbuyshop.de) läuft auf Vercel.
# Dort dieselben NAMEN im Vercel Dashboard setzen (Production / Preview / Development)
# und danach neu deployen. NEXT_PUBLIC_* werden beim Build eingefroren.
#
# Niemals echte Secret-Werte in diese Datei schreiben.

# =============================================================================
# Development (lokal)
# =============================================================================
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# PAYPAL_ENV=sandbox
# Stripe: Test-Keys (sk_test_… / pk_test_…)
# PayPal: Sandbox Client ID + Secret
# Stripe-Webhook lokal: Stripe CLI → whsec_…
#
# =============================================================================
# Production (Vercel → https://www.techbuyshop.de)
# =============================================================================
# NEXT_PUBLIC_SITE_URL=https://www.techbuyshop.de
# PAYPAL_ENV=live
# Stripe: Live-Keys (sk_live_… / pk_live_…)
# PayPal: Live Client ID + Secret
# STRIPE_WEBHOOK_SECRET und PAYPAL_WEBHOOK_ID aus den jeweiligen Dashboards

# -----------------------------------------------------------------------------
# Site URL (ohne Slash am Ende)
# Dev: http://localhost:3000
# Prod: https://www.techbuyshop.de
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Stripe
# Dev: Test-Keys   Prod: Live-Keys
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional — nur für Checkout-Modus über feste Stripe Price ID
STRIPE_PRICE_ID=

# -----------------------------------------------------------------------------
# PayPal
# Dev: PAYPAL_ENV=sandbox   Prod: PAYPAL_ENV=live
# -----------------------------------------------------------------------------
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

# -----------------------------------------------------------------------------
# E-Mail (IONOS SMTP, nur Server)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_REPLY_TO=

# -----------------------------------------------------------------------------
# Admin-Login (keine Fallbacks — alle drei sind Pflicht)
# -----------------------------------------------------------------------------
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
