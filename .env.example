# TechBuy — lokale Secrets (niemals committen)
# Kopiere diese Datei nach `.env.local` und trage deine Werte ein.

# Stripe Secret Key (Dashboard → Entwickler → API-Schlüssel)
# Test: sk_test_…   Live: sk_live_…
STRIPE_SECRET_KEY=

# Stripe Publishable Key (darf im Frontend landen)
# Test: pk_test_…   Live: pk_live_…
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional: Stripe Price ID für Einzelkauf über festen Stripe-Preis
# Dashboard → Produkte → Preis → Price ID (price_…)
STRIPE_PRICE_ID=

# Stripe Webhook Signing Secret (Dashboard → Entwickler → Webhooks)
# Lokal oft über Stripe CLI: whsec_…
STRIPE_WEBHOOK_SECRET=

# PayPal (Sandbox zuerst)
# Developer Dashboard → Apps & Credentials → Sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_ENV=sandbox
# Webhook ID aus PayPal Developer Dashboard (nach Webhook-Anlage)
PAYPAL_WEBHOOK_ID=

# Transaktions-E-Mails über IONOS SMTP (nur Server — niemals im Browser)
SMTP_HOST=smtp.ionos.de
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@techbuyshop.de
SMTP_PASSWORD=
EMAIL_FROM="TechBuy <info@techbuyshop.de>"
EMAIL_REPLY_TO=info@techbuyshop.de

# Admin-Login (optional — sonst Defaults nur für lokale Entwicklung)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Öffentliche Basis-URL der Shop-Seite (ohne Slash am Ende)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
